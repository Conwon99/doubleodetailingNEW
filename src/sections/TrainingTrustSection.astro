---
/** Professional training + local garages who vouch for Double O Detailing. */
import { training, localConnections } from "../data/serviceShowcase";
---

<section class="box-border bg-white py-[60px] md:py-[100px]">
  <div class="box-border w-full max-w-[1204px] mx-auto px-5 md:px-8 grid grid-cols-1 lg:grid-cols-[2fr_1fr] gap-12 lg:gap-16">
    <div class="flex flex-col gap-y-8">
      <div>
        <div class="inline-block border border-black/20 px-3 py-1 rounded-[1000px] mb-4">
          <span class="font-medium leading-[22px]">Training</span>
        </div>
        <h2 class="font-refrigerator uppercase text-3xl font-bold tracking-[-0.52px] leading-tight md:text-5xl md:leading-tight">
          Professional training &amp; development
        </h2>
        <p class="text-[15px] leading-6 text-gray-700 md:text-base mt-4 max-w-[640px]">
          At Double O Detailing, we've invested in professional training to develop our knowledge, practical skills and
          workmanship, ensuring every vehicle receives the appropriate level of care.
        </p>
      </div>
      <div class="flex flex-col gap-y-4">
        {training.map((t) => (
          <div class="rounded-2xl border border-neutral-200 bg-neutral-50 p-5 md:p-6 flex flex-col sm:flex-row gap-5">
            <div class="w-24 h-16 shrink-0 flex items-center justify-center bg-white rounded-xl border border-neutral-200 p-2">
              <img src={t.logo.src} alt={t.logo.alt} loading="lazy" class="max-w-full max-h-full object-contain" />
            </div>
            <div class="flex flex-col gap-y-2">
              <h3 class="text-lg font-semibold leading-6">{t.title}</h3>
              <p class="text-[15px] leading-6 text-gray-700">{t.body}</p>
              <div class="flex flex-wrap gap-2 mt-1">
                {t.badges.map((b) => (
                  <span class="text-xs font-medium bg-amber-50 text-amber-800 border border-amber-200 rounded-full px-2.5 py-1">{b}</span>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <div class="flex flex-col gap-y-6 lg:pt-[92px]">
      <div class="rounded-2xl bg-black text-white p-6 md:p-8">
        <h2 class="font-refrigerator uppercase text-2xl font-bold tracking-[-0.3px] leading-tight md:text-3xl">
          Trusted local automotive connections
        </h2>
        <p class="text-[15px] leading-6 text-white/80 mt-3">
          We're fortunate to have built relationships with several respected automotive businesses in the local area. The
          owners of these businesses are familiar with Double O Detailing and can personally vouch for the quality of our
          workmanship and service.
        </p>
        <ul class="mt-5 flex flex-col gap-y-3">
          {localConnections.map((c) => (
            <li class="flex gap-3 items-start text-[15px] leading-6">
              <svg class="h-5 w-5 shrink-0 mt-0.5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
              <span>{c}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
