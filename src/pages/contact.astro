---
import Layout from '../layouts/Layout.astro';
import { Navbar } from '../sections/Navbar';
import { QuoteSection } from '../sections/QuoteSection';
import { FooterSection } from '../sections/FooterSection';
---

<Layout 
  title="Contact Double O Detailing | Free Detailing Quote, Killearn"
  description="Contact Double O Detailing for a free quote on car detailing services. Call 07768 243 728 or fill out our contact form. Based in Killearn, covering Loch Lomond, Bearsden, Milngavie and Glasgow North."
  canonical="https://doubleodetailing.co.uk/contact"
>
  <div class="min-h-screen bg-neutral-100 font-figtree text-black text-sm leading-5 antialiased">
    <Navbar client:load />
    <main class="pt-0">
      <section class="pt-[120px] md:pt-[150px] pb-4">
        <div class="max-w-[1204px] mx-auto px-5 md:px-8">
          <h1 class="text-[44px] font-bold tracking-[-1.44px] leading-[52px] md:text-7xl md:leading-[80px] font-refrigerator uppercase">Contact us</h1>
          <p class="text-[15px] leading-6 text-gray-700 mt-3 md:text-base max-w-[680px]">
            Call <a class="underline" href="tel:07768243728">07768 243728</a>, email <a class="underline" href="mailto:doubleodetailing@icloud.com">doubleodetailing@icloud.com</a> or use the form below. We're based in Killearn and cover Loch Lomond, Bearsden, Milngavie and Glasgow North. To help us quote, tell us your car, what you'd like done, and add a few photos if you can.
          </p>
        </div>
      </section>
      <QuoteSection client:load showTerms={false} />
      <FooterSection client:load />
    </main>
  </div>
</Layout>
