---
import Layout from '../layouts/Layout.astro';
import { Navbar } from '../sections/Navbar';
import { ServiceAreasSection } from '../sections/ServiceAreasSection';
import ReviewsSection from '../sections/ReviewsSection.astro';
import { QuoteSection } from '../sections/QuoteSection';
import { FooterSection } from '../sections/FooterSection';
import { COVERAGE_HEADLINE } from '../data/locations';
---

<Layout
  title="Jet Ski and Boat Detailing - Double O Detailing | Loch Lomond Workshop"
  description="Specialist jet ski and boat detailing and protection at our Killearn workshop. Deep clean, decontamination, interior and exterior care, and marine coatings."
  canonical="https://doubleodetailing.co.uk/jet-ski-detailing"
>
  <div class="min-h-screen bg-neutral-100 font-figtree text-black text-sm leading-5 antialiased">
    <Navbar client:load />
    <main class="pt-0">
      <section class="relative text-white overflow-hidden min-h-[70vh]">
        <div class="absolute inset-0 bg-cover bg-center bg-no-repeat" style="background-image: url('/Deep clean detailing.png');"></div>
        <div class="absolute inset-0 bg-gradient-to-r from-black/90 via-black/60 to-transparent"></div>
        <div class="relative mx-auto flex min-h-[70vh] w-full max-w-[1204px] flex-col justify-end px-5 pb-12 pt-32 md:px-8 md:pt-28">
          <h1 class="text-4xl font-bold font-refrigerator uppercase md:text-6xl">Jet Ski and Boat Detailing</h1>
          <p class="mt-4 max-w-[640px] text-base md:text-lg">
            Specialist jet ski and boat detailing and protection from our workshop in Killearn. {COVERAGE_HEADLINE}
          </p>
          <a href="/contact" class="mt-6 inline-flex w-fit items-center rounded-[100px] bg-cta px-6 py-3 text-sm font-medium text-black hover:bg-white">
            BOOK NOW
          </a>
        </div>
      </section>
      <section class="bg-white py-16 md:py-24">
        <div class="max-w-[1204px] mx-auto px-5 md:px-8">
          <h2 class="font-refrigerator uppercase text-2xl md:text-3xl font-bold mb-4">Workshop Marine Services</h2>
          <p class="text-gray-700 text-base leading-6 max-w-[720px]">
            Our unit-based jet ski and boat service includes thorough cleaning, decontamination, interior and exterior care, and protection options tailored to marine surfaces. Unit services are available year-round for optimal results and curing conditions.
          </p>
        </div>
      </section>
      <ServiceAreasSection client:load />
      <ReviewsSection />
      <QuoteSection client:load showTerms={false} />
      <FooterSection client:load />
    </main>
  </div>
</Layout>
