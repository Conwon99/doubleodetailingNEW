---
import PackagePicker from '../sections/PackagePicker.astro';
import Layout from '../layouts/Layout.astro';
import { Navbar } from '../sections/Navbar';
import { HeroStats } from '../sections/Hero/components/HeroStats';
import { WhyChooseMachinePolishingSection } from '../sections/CoreValuesSection/WhyChooseMachinePolishingSection';
import { ProcessSectionMachinePolishing } from '../sections/ProcessSection/ProcessSectionMachinePolishing';
import ServiceShowcaseSection from '../sections/ServiceShowcaseSection.astro';
import TrainingTrustSection from '../sections/TrainingTrustSection.astro';
import ServiceFAQSection from '../sections/ServiceFAQSection.astro';
import { paintCorrection, glossEnhancement } from '../data/serviceShowcase';
import { ServiceAreasSection } from '../sections/ServiceAreasSection';
import ReviewsSection from '../sections/ReviewsSection.astro';
import { PackageCategorySection } from '../sections/PackageCategorySection';
import { QuoteSection } from '../sections/QuoteSection';
import { FooterSection } from '../sections/FooterSection';
---

<Layout 
  title="Paint Correction & Car Polishing Killearn | Double O Detailing"
  description="Paint correction, gloss enhancement and car polishing from our Killearn unit, with ceramic protection included. See real jobs, prices and reviews. Free quote."
  canonical="https://doubleodetailing.co.uk/machine-polishing"
>
  <div class="min-h-screen bg-neutral-100 font-figtree text-black text-sm leading-5 antialiased">
    <Navbar client:load />
    <main class="pt-0">
      <!-- Hero - same design as home page, image from Machine Polishing service card -->
      <section class="relative text-white overflow-hidden min-h-screen">
        <div class="absolute inset-0">
          <div
            class="absolute inset-0 bg-cover bg-center bg-no-repeat"
            style="background-image: url(&quot;/Machine polishing.webp&quot;);"
          />
        </div>
        <div class="absolute inset-0 bg-gradient-to-r from-black/90 via-black/50 to-transparent" />
        <div class="relative mx-auto flex min-h-screen w-full max-w-[1204px] flex-col justify-end px-5 pb-8 pt-32 md:px-8 md:pb-12 md:pt-28 supports-[min-height:100dvh]:min-h-[100dvh]">
          <div class="items-start box-border gap-x-10 flex flex-col justify-between gap-y-10 md:items-end md:gap-x-[60px] md:flex-row md:gap-y-[60px] w-full">
            <div class="box-border basis-[0%] grow max-w-[650px] pt-24 md:pt-32">
              <div class="box-border gap-x-4 flex flex-col gap-y-4">
                <h1 class="text-[44px] font-bold box-border tracking-[-1.44px] leading-[52px] md:text-7xl md:leading-[80px] font-refrigerator uppercase">
                  <div>Paint Correction</div>
                  <div>& Car Polishing</div>
                </h1>
                <p class="text-base leading-[26px] md:text-lg font-figtree">
                  Machine polishing from our Killearn unit to remove swirl marks, scratches and dull, oxidised paint. Choose single-stage paint correction or a lighter gloss enhancement (minor paint correction), both finished with ceramic protection.
                </p>
              </div>
              <div class="items-center box-border gap-x-5 flex flex-wrap gap-y-5 mt-6 md:gap-x-6 md:gap-y-6 md:mt-7">
                <a
                  href="https://clienthub.getjobber.com/hubs/a44bef51-533c-4e99-b56c-1a3b824ae502/public/requests/5099095/new" target="_blank" rel="noopener noreferrer"
                  class="text-black items-center bg-cta box-border gap-x-5 flex max-w-full gap-y-5 text-center border pl-6 pr-1 py-1 rounded-[100px] border-solid border-transparent hover:bg-white hover:border-cta-dark"
                >
                  <span class="relative text-sm font-medium z-[2] md:text-base md:leading-6">BOOK NOW</span>
                  <span class="text-white items-center bg-[#8B6B3D] box-border flex h-12 justify-center w-12 overflow-hidden rounded-[50%]">
                    <img src="https://c.animaapp.com/mhnzg6knJo6lE7/assets/icon-4.svg" alt="" class="h-3.5 w-3.5" style="filter: brightness(0) saturate(100%) invert(78%) sepia(45%) saturate(500%) hue-rotate(330deg) brightness(110%) contrast(85%)" />
                  </span>
                </a>
                <a href="#packages" class="relative items-center box-border gap-x-2 flex max-w-full gap-y-2 overflow-hidden">
                  <span class="text-[15px] font-medium leading-6 md:text-base">View Paint Correction Packages</span>
                  <span class="relative h-6 w-6 overflow-hidden">
                    <img src="https://c.animaapp.com/mhnzg6knJo6lE7/assets/icon-5.svg" alt="" class="h-full w-full" />
                  </span>
                  <span class="absolute bg-white box-border h-px bottom-0 inset-x-0" />
                </a>
              </div>
            </div>
            <HeroStats client:load />
          </div>
      </section>

      <PackageCategorySection client:load categoryId="machine-polishing" embedded heading="Paint correction packages" />

      <ServiceShowcaseSection id="paint-correction" showcase={paintCorrection} intro="Single-stage paint correction for paintwork with visible swirls, oxidation, wash marring and lighter defects. Our Casino Royale package." />

      <ServiceShowcaseSection id="gloss-enhancement" showcase={glossEnhancement} muted={false} resultsHeading="Gloss enhancement (minor paint correction)" intro="A lighter machine polish for new or well-kept paintwork, refining very fine imperfections and adding gloss before ceramic protection. Our No Time To Die package." />

      <WhyChooseMachinePolishingSection client:load />

      <ProcessSectionMachinePolishing client:load />

      <ServiceFAQSection
        heading="Paint correction & gloss enhancement FAQs"
        groups={[
          { title: "Paint correction", faqs: paintCorrection.faqs },
          { title: "Gloss enhancement", faqs: glossEnhancement.faqs },
          { title: "Prices", faqs: [
            { question: "How much does paint correction cost?", answer: "Single-stage paint correction starts from £350 with 12-month ceramic protection included, rising to £425 with a 2-year coating or £500 with a 3-year coating. Gloss enhancement (minor paint correction) starts from £295. Prices depend on vehicle size and paint condition, and we confirm the price after inspecting the paint." },
            { question: "Is car polishing the same as paint correction?", answer: "Paint correction is machine polishing done to remove defects such as swirl marks, wash marring and light scratches, rather than just adding shine. Our gloss enhancement is a lighter polish for paint in good condition; single-stage paint correction removes more defects." },
          ] },
          { title: "Booking", faqs: [{ question: "Can you polish my car at my home or workplace?", answer: "Often, yes. Mobile appointments are available seasonally, weather permitting, and we bring our own power and water. Three-year ceramic coatings are carried out at our Killearn unit because they need overnight curing." }] },
        ]}
      />

      <PackagePicker
        heading="Book your paint correction"
        intro="Both packages include full paint preparation and 12-month ceramic protection, with 2-year and 3-year coating upgrades. We confirm which one suits your paint after an inspection."
        picks={[
          { id: "no-time-to-die", reason: "Gloss enhancement (minor paint correction) for newer or well-kept paint with light haze and fine swirls." },
          { id: "casino-royale", label: "Most correction", reason: "Single-stage paint correction for visibly swirled, dull or weathered paint that needs real defect removal." },
        ]}
      />

      <TrainingTrustSection />

      <ServiceAreasSection client:load />

      <ReviewsSection title="Reviews" />

      <QuoteSection client:load showTerms={false} />
      <FooterSection client:load />
    </main>
  </div>
</Layout>
