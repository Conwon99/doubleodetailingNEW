---
import Layout from '../layouts/Layout.astro';
import { Navbar } from '../sections/Navbar';
import { ServicePageServices } from '../sections/ServicePageServices';
import ReviewsSection from '../sections/ReviewsSection.astro';
import { QuoteSection } from '../sections/QuoteSection';
import { FooterSection } from '../sections/FooterSection';
---

<Layout
  title="Car Detailing Services & Prices | Double O Detailing, Killearn"
  description="Paint correction, ceramic coatings and full details from our Killearn unit, covering Loch Lomond, Bearsden, Milngavie and Glasgow North. Prices from £170."
  canonical="https://doubleodetailing.co.uk/services/"
>
  <div class="min-h-screen bg-white font-figtree text-black text-sm leading-5 antialiased">
    <Navbar client:load />
    <main class="pt-0">
      <section class="box-border overflow-hidden pt-[120px] md:pt-[150px] pb-10 md:pb-14">
        <div class="box-border max-w-[1204px] mx-auto px-5 md:px-8">
          <h1 class="text-[44px] font-bold tracking-[-1.44px] leading-[52px] md:text-7xl md:leading-[80px] font-refrigerator uppercase">
            Our Services
          </h1>
          <p class="text-[15px] leading-6 text-gray-700 mt-4 md:text-base max-w-[680px]">
            Paint correction, ceramic coatings and full details from our unit in Killearn, covering Loch Lomond, Bearsden, Milngavie and Glasgow North. Not sure which you need?
            <a href="/packages/find-my-package/" class="underline">Find your package</a>.
          </p>
        </div>
      </section>
      <ServicePageServices client:load heading="What we do." />
      <section class="bg-white box-border pb-[60px] md:pb-[100px]">
        <div class="box-border max-w-[1204px] mx-auto px-5 md:px-8">
          <div class="box-border flex flex-wrap justify-center gap-3">
            <a
              href="https://clienthub.getjobber.com/hubs/a44bef51-533c-4e99-b56c-1a3b824ae502/public/requests/5099095/new" target="_blank" rel="noopener noreferrer"
              class="text-white items-center bg-cta-dark box-border gap-x-3 flex max-w-full gap-y-3 text-center border border-cta-dark px-6 py-4 rounded-[100px] border-solid hover:text-cta-dark hover:bg-white transition"
            >
              <span class="relative text-sm font-medium z-[2] md:text-base md:leading-6">BOOK NOW</span>
              <span class="box-border">
                <svg class="h-2 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
              </span>
            </a>
            <a
              href="/packages/"
              class="text-cta-dark items-center box-border gap-x-3 flex max-w-full gap-y-3 text-center border border-cta-dark px-6 py-4 rounded-[100px] border-solid hover:bg-cta-dark hover:text-white transition"
            >
              <span class="relative text-sm font-medium z-[2] md:text-base md:leading-6">View Packages &amp; Prices</span>
              <span class="box-border">
                <svg class="h-2 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
              </span>
            </a>
          </div>
        </div>
      </section>
      <ReviewsSection title="Reviews" />
      <QuoteSection client:load showTerms={false} />
      <FooterSection client:load />
    </main>
  </div>
</Layout>
