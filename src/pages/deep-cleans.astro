---
import PackagePicker from '../sections/PackagePicker.astro';
import Layout from '../layouts/Layout.astro';
import { Navbar } from '../sections/Navbar';
import { HeroStats } from '../sections/Hero/components/HeroStats';
import { WhyChooseDeepCleanSection } from '../sections/CoreValuesSection/WhyChooseDeepCleanSection';
import { ProcessSectionDeepClean } from '../sections/ProcessSection/ProcessSectionDeepClean';
import ServiceShowcaseSection from '../sections/ServiceShowcaseSection.astro';
import TrainingTrustSection from '../sections/TrainingTrustSection.astro';
import ServiceFAQSection from '../sections/ServiceFAQSection.astro';
import { fullDetail } from '../data/serviceShowcase';
import { ServiceAreasSection } from '../sections/ServiceAreasSection';
import ReviewsSection from '../sections/ReviewsSection.astro';
import { PackageCategorySection } from '../sections/PackageCategorySection';
import { QuoteSection } from '../sections/QuoteSection';
import { FooterSection } from '../sections/FooterSection';
---

<Layout
  title="Full Valet & Car Detailing Killearn & Glasgow North | Double O"
  description="A premium full valet from £170: interior deep clean, carpet shampoo, decontamination and 6-month paint protection. Killearn unit and mobile valeting across Glasgow North."
  canonical="https://doubleodetailing.co.uk/deep-cleans"
>
  <div class="min-h-screen bg-neutral-100 font-figtree text-black text-sm leading-5 antialiased">
    <Navbar client:load />
    <main class="pt-0">
      <section class="relative text-white overflow-hidden min-h-screen">
        <div class="absolute inset-0">
          <div class="absolute inset-0 bg-cover bg-center bg-no-repeat" style="background-image: url(&quot;/Deep clean detailing.webp&quot;);" />
        </div>
        <div class="absolute inset-0 bg-gradient-to-r from-black/90 via-black/50 to-transparent" />
        <div class="relative mx-auto flex min-h-screen w-full max-w-[1204px] flex-col justify-end px-5 pb-8 pt-32 md:px-8 md:pb-12 md:pt-28 supports-[min-height:100dvh]:min-h-[100dvh]">
          <div class="items-start box-border gap-x-10 flex flex-col justify-between gap-y-10 md:items-end md:gap-x-[60px] md:flex-row md:gap-y-[60px] w-full">
            <div class="box-border basis-[0%] grow max-w-[650px] pt-24 md:pt-32">
              <div class="box-border gap-x-4 flex flex-col gap-y-4">
                <h1 class="text-[44px] font-bold box-border tracking-[-1.44px] leading-[52px] md:text-7xl md:leading-[80px] font-refrigerator uppercase">
                  <div>Full Valet &</div>
                  <div>Car Detailing</div>
                </h1>
                <p class="text-base leading-[26px] md:text-lg font-figtree">
                  Our Full Detail is a premium full valet: a deep interior clean with carpets and mats shampooed, a full exterior decontamination and 6-month paint protection. Available at our Killearn unit or as a mobile valet across Glasgow North.
                </p>
              </div>
              <div class="items-center box-border gap-x-5 flex flex-wrap gap-y-5 mt-6 md:gap-x-6 md:gap-y-6 md:mt-7">
                <a href="https://clienthub.getjobber.com/hubs/a44bef51-533c-4e99-b56c-1a3b824ae502/public/requests/5099095/new" target="_blank" rel="noopener noreferrer" class="text-black items-center bg-cta box-border gap-x-5 flex max-w-full gap-y-5 text-center border pl-6 pr-1 py-1 rounded-[100px] border-solid border-transparent hover:bg-white hover:border-cta-dark">
                  <span class="relative text-sm font-medium z-[2] md:text-base md:leading-6">BOOK NOW</span>
                  <span class="text-white items-center bg-[#8B6B3D] box-border flex h-12 justify-center w-12 overflow-hidden rounded-[50%]">
                    <img src="https://c.animaapp.com/mhnzg6knJo6lE7/assets/icon-4.svg" alt="" class="h-3.5 w-3.5" style="filter: brightness(0) saturate(100%) invert(78%) sepia(45%) saturate(500%) hue-rotate(330deg) brightness(110%) contrast(85%)" />
                  </span>
                </a>
                <a href="#packages" class="relative items-center box-border gap-x-2 flex max-w-full gap-y-2 overflow-hidden">
                  <span class="text-[15px] font-medium leading-6 md:text-base">View Full Valet Packages</span>
                  <span class="relative h-6 w-6 overflow-hidden">
                    <img src="https://c.animaapp.com/mhnzg6knJo6lE7/assets/icon-5.svg" alt="" class="h-full w-full" />
                  </span>
                  <span class="absolute bg-white box-border h-px bottom-0 inset-x-0" />
                </a>
              </div>
            </div>
            <HeroStats client:load />
          </div>
      </section>

      <PackageCategorySection client:load categoryId="deep-clean" embedded heading="Full detail packages" />

      <ServiceShowcaseSection id="results" showcase={fullDetail} intro="A comprehensive interior and exterior detail for vehicles that need more than a maintenance wash, without machine polishing." />
      <WhyChooseDeepCleanSection client:load />
      <ProcessSectionDeepClean client:load />
      <ServiceFAQSection heading="Full valet & detail FAQs" groups={[
        { faqs: fullDetail.faqs },
        { title: "Valeting", faqs: [
          { question: "Is a Full Detail the same as a full valet?", answer: "It's a more thorough version of one. A typical full valet is a wash, hoover and wipe-down; our Full Detail adds chemical decontamination (tar, iron and sap removal), carpet and mat shampoo and extraction, door shuts, and 6-month paint protection." },
          { question: "How much does a full valet cost?", answer: "Our Full Detail starts from £170 for a small car, £185 medium, £200 large and £230 for vans and 7-seaters. Very dirty vehicles, excessive pet hair or odours may need a separate quote." },
          { question: "Can you remove pet hair and odours?", answer: "Yes. Excessive pet hair removal and ozone odour treatment are available as add-ons to a Full Detail, priced on inspection." },
          { question: "Can you protect the seats and carpets after cleaning?", answer: "Yes. Our interior fabric coating can be added after the clean to help repel spills and stains. See interior fabric coating for details." },
        ] },
      ]} />

      <PackagePicker
        heading="Book your full valet"
        intro="Start with a Full Valet to bring the car up to standard, then keep it there with a maintenance valet every few weeks."
        picks={[
          { id: "shaken-not-stirred", label: "Start here", reason: "The full interior and exterior reset: decontamination, carpets and mats shampooed and 6-month paint protection. Add engine bay, pet hair or odour treatment." },
          { id: "spectre", reason: "Afterwards: a maintenance valet every 3–8 weeks keeps the car at the same standard for less." },
        ]}
      />

      <TrainingTrustSection />
      <ServiceAreasSection client:load />
      <ReviewsSection title="Reviews" />
      <QuoteSection client:load showTerms={false} />
      <FooterSection client:load />
    </main>
  </div>
</Layout>
