---
import '../styles/tailwind.css';
import { locations } from '../data/locations';
import { GOOGLE_REVIEW_COUNT } from '../data/business';

interface LocationSchemaProp {
  name: string;
  slug: string;
  addressLocality: string;
  latitude: string;
  longitude: string;
}

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: string;
  canonical?: string;
  noindex?: boolean;
  locationSchema?: LocationSchemaProp;
}

const {
  title = "Double O Detailing - Premium Vehicle Detailing in Glasgow",
  description = "Workshop based in Killearn, covering Loch Lomond, Glasgow West End & surrounding premium areas. Machine polishing, ceramic coatings, deep cleans, and maintenance.",
  image = "https://doubleodetailing.co.uk/double-o-logo.png",
  type = "website",
  canonical: canonicalProp = `https://doubleodetailing.co.uk${Astro.url.pathname}`,
  noindex = false,
  locationSchema,
} = Astro.props;

const siteUrl = "https://doubleodetailing.co.uk";
// Netlify serves every page from a folder, so the trailing-slash URL is the one
// that returns 200. Keep canonicals on that version to stop redirect/canonical clashes.
const canonical = canonicalProp.endsWith('/') ? canonicalProp : `${canonicalProp}/`;
const fullImageUrl = image.startsWith('http') ? image : `${siteUrl}${image}`;

const defaultAreaServed = [
  ...locations.map((loc) => ({ "@type": "City", "name": loc.name })),
  { "@type": "State", "name": "Central Scotland" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content="car detailing, mobile car detailing, Loch Lomond, Killearn, Glasgow West End, ceramic coating, paint correction and gloss enhancements" />
    <meta name="author" content="Double O Detailing" />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />
    <meta name="language" content="English" />
    <meta name="revisit-after" content="7 days" />
    
    <!-- Canonical URL -->
    <link rel="canonical" href={canonical} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullImageUrl} />
    <meta property="og:site_name" content="Double O Detailing" />
    <meta property="og:locale" content="en_GB" />
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullImageUrl} />
    
    <!-- Business Information -->
    <meta name="geo.region" content="GB-SCT" />
    <meta name="geo.placename" content="Glasgow" />
    <meta name="geo.position" content="55.8642;-4.2518" />
    <meta name="ICBM" content="55.8642, -4.2518" />
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Figtree:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Bungee&family=Courier+Prime:ital,wght@0,400;0,700;1,400;1,700&family=Luckiest+Guy&family=Manrope:wght@200..800&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">
    
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-ZVTPX27J1H"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      // Consent mode: analytics storage stays off until the visitor accepts.
      var ddConsent = null;
      try { ddConsent = localStorage.getItem('dd-consent'); } catch (e) {}
      gtag('consent', 'default', {
        ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied',
        analytics_storage: ddConsent === 'granted' ? 'granted' : 'denied'
      });
      gtag('js', new Date());
      gtag('config', 'G-ZVTPX27J1H');
    </script>
    
    <!-- JSON-LD Schema -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "@id": "https://doubleodetailing.co.uk/#localbusiness",
      "name": "Double O Detailing",
      "alternateName": "Double-O Detailing",
      "description": "Workshop based in Killearn, covering Loch Lomond, Glasgow West End and surrounding premium areas. Premium car detailing.",
      "url": "https://doubleodetailing.co.uk",
      "logo": "https://doubleodetailing.co.uk/double-o-logo.png",
      "image": "https://doubleodetailing.co.uk/double-o-logo.png",
      "telephone": "+447768243728",
      "email": "doubleodetailing@icloud.com",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Killearn",
        "addressRegion": "Stirlingshire",
        "addressCountry": "GB"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": "56.0392",
        "longitude": "-4.3686"
      },
      "areaServed": defaultAreaServed,
      "serviceType": [
        "Car Detailing",
        "Mobile Car Detailing",
        "Ceramic Coating",
        "Paint Correction and Gloss Enhancements",
        "Deep Cleaning",
        "Car Maintenance"
      ],
      "priceRange": "££",
      "openingHoursSpecification": {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": [
          "Monday",
          "Tuesday",
          "Wednesday",
          "Thursday",
          "Friday",
          "Saturday"
        ],
        "opens": "08:00",
        "closes": "18:00"
      },
      "sameAs": [
        "https://www.facebook.com/p/Double-O-Detailing-61562055449917/",
        "https://www.instagram.com/doubleo.detailing/"
      ],
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "5",
        "reviewCount": String(GOOGLE_REVIEW_COUNT),
        "bestRating": "5",
        "worstRating": "1"
      }
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "@id": "https://doubleodetailing.co.uk/#website",
      "name": "Double O Detailing",
      "url": "https://doubleodetailing.co.uk",
      "description": "Paint correction, ceramic coatings and full details from our Killearn unit, covering Loch Lomond, Bearsden, Milngavie and Glasgow North.",
      "publisher": { "@id": "https://doubleodetailing.co.uk/#organization" },
      "inLanguage": "en-GB"
    })} />
    
    {locationSchema && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Service",
        "name": `Mobile car detailing in ${locationSchema.name}`,
        "serviceType": "Mobile Car Detailing",
        "url": `${siteUrl}/${locationSchema.slug}/`,
        "provider": {
          "@type": "LocalBusiness",
          "name": "Double O Detailing",
          "url": `${siteUrl}/`,
          "telephone": "+447768243728"
        },
        "areaServed": {
          "@type": "Place",
          "name": `${locationSchema.name}, ${locationSchema.addressLocality}`,
          "geo": {
            "@type": "GeoCoordinates",
            "latitude": locationSchema.latitude,
            "longitude": locationSchema.longitude
          }
        }
      })} />
    )}
    
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "@id": "https://doubleodetailing.co.uk/#organization",
      "name": "Double O Detailing",
      "url": "https://doubleodetailing.co.uk",
      "logo": "https://doubleodetailing.co.uk/double-o-logo.png",
      "contactPoint": {
        "@type": "ContactPoint",
        "telephone": "+447768243728",
        "contactType": "Customer Service",
        "areaServed": "GB",
        "availableLanguage": "English"
      },
      "sameAs": [
        "https://www.facebook.com/p/Double-O-Detailing-61562055449917/",
        "https://www.instagram.com/doubleo.detailing/"
      ]
    })} />
  </head>
  <body>
    <slot />
    <!-- Mobile message widget - bottom right, visible on small screens only -->
    <a
      href="/contact/"
      class="fixed bottom-5 right-5 z-50 flex md:hidden items-center gap-2 bg-cta-dark text-white px-4 py-3 rounded-full shadow-lg hover:bg-cta focus:outline-none focus:ring-2 focus:ring-cta-dark focus:ring-offset-2"
      aria-label="Message us / Get a quote"
    >
      <svg class="w-6 h-6 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden>
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.864 9.864 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
      </svg>
      <span class="font-medium text-sm">Message</span>
    </a>

    <div id="dd-consent" hidden style="position:fixed;left:16px;right:16px;bottom:16px;z-index:9999;max-width:560px;margin:0 auto;background:#111;color:#fff;border-radius:14px;padding:16px 18px;font:14px/1.45 Figtree,system-ui,sans-serif;box-shadow:0 8px 30px rgba(0,0,0,.3)">
      <p style="margin:0 0 12px">We'd like to use analytics cookies to see how the site is used. <a href="/privacy-policy/" style="color:#fff;text-decoration:underline">Privacy policy</a></p>
      <div style="display:flex;gap:8px;justify-content:flex-end">
        <button type="button" data-consent="denied" style="background:transparent;color:#fff;border:1px solid #fff;border-radius:999px;padding:8px 16px;cursor:pointer">Decline</button>
        <button type="button" data-consent="granted" style="background:#fff;color:#111;border:0;border-radius:999px;padding:8px 16px;cursor:pointer">Accept</button>
      </div>
    </div>
    <script is:inline>
      (function () {
        var box = document.getElementById('dd-consent');
        var saved = null;
        try { saved = localStorage.getItem('dd-consent'); } catch (e) {}
        if (!saved) box.hidden = false;
        box.addEventListener('click', function (e) {
          var v = e.target && e.target.getAttribute('data-consent');
          if (!v) return;
          try { localStorage.setItem('dd-consent', v); } catch (e) {}
          if (typeof gtag === 'function') gtag('consent', 'update', { analytics_storage: v });
          box.hidden = true;
        });
        window.ddCookieSettings = function () { box.hidden = false; };
      })();
    </script>
  </body>
</html>
